{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "generate": {
      "inputs": [
        "generate.sh",
        "package.json",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/pkg/**/*.go",
        "$TURBO_ROOT$/pkg/**/go.mod",
        "$TURBO_ROOT$/pkg/**/go.sum",
        "$TURBO_ROOT$/platform/aws/provider/**/*.go",
        "$TURBO_ROOT$/platform/aws/provider/go.mod",
        "$TURBO_ROOT$/platform/aws/provider/go.sum",
        "$TURBO_ROOT$/platform/aws/runtime/**/*.go",
        "$TURBO_ROOT$/platform/aws/runtime/go.mod",
        "$TURBO_ROOT$/platform/aws/runtime/go.sum",
        "$TURBO_ROOT$/platform/s3/**/*.go",
        "$TURBO_ROOT$/platform/s3/go.mod",
        "$TURBO_ROOT$/platform/s3/go.sum",
        "$TURBO_ROOT$/platform/realtime/**/*.go",
        "$TURBO_ROOT$/platform/realtime/go.mod",
        "$TURBO_ROOT$/platform/realtime/go.sum",
        "!$TURBO_ROOT$/**/*_test.go"
      ]
    },
    "live": {
      "dependsOn": ["generate"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pkg/**",
        "$TURBO_ROOT$/proto/**",
        "$TURBO_ROOT$/platform/aws/**",
        "$TURBO_ROOT$/platform/edge/**",
        "$TURBO_ROOT$/scripts/floci.sh",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/go.work.sum",
        "$TURBO_ROOT$/.github/workflows/integration.yml",
        "$TURBO_ROOT$/.github/actions/**",
        "!$TURBO_ROOT$/**/*.md"
      ]
    },
    "lifecycle": {
      "dependsOn": ["generate"],
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/cli/**",
        "$TURBO_ROOT$/sdk/**",
        "$TURBO_ROOT$/pkg/**",
        "$TURBO_ROOT$/proto/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/frameworks/**",
        "$TURBO_ROOT$/platform/aws/**",
        "$TURBO_ROOT$/platform/edge/**",
        "$TURBO_ROOT$/scripts/floci.sh",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/go.work.sum",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/.github/workflows/integration.yml",
        "$TURBO_ROOT$/.github/actions/**",
        "!$TURBO_ROOT$/**/*.md"
      ]
    }
  }
}
