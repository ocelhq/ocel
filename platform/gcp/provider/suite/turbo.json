{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "live": {
      "cache": false,
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pkg/**",
        "$TURBO_ROOT$/proto/**",
        "$TURBO_ROOT$/platform/gcp/**",
        "$TURBO_ROOT$/platform/edge/**",
        "$TURBO_ROOT$/scripts/floci.sh",
        "$TURBO_ROOT$/scripts/assert-ran.sh",
        "$TURBO_ROOT$/go.work",
        "$TURBO_ROOT$/go.work.sum",
        "$TURBO_ROOT$/.github/workflows/go.yml",
        "$TURBO_ROOT$/.github/actions/**",
        "!$TURBO_ROOT$/**/*.md"
      ]
    }
  }
}
