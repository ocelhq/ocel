{
  "rules": [
    { "path": "/", "revalidate": 30 },
    { "path": "/blog/drafts/*", "revalidate": 5 },
    { "path": "/blog/*", "revalidate": 60, "expire": 600 },
    { "path": "/docs/guide", "revalidate": 10, "expire": 11 },
    { "path": "/*", "revalidate": 1 }
  ],
  "cases": [
    { "path": "/", "rule": 0, "cacheControl": "s-maxage=30" },
    { "path": "/blog/post", "rule": 2, "cacheControl": "s-maxage=60, stale-while-revalidate=540" },
    { "path": "/blog/a/b", "rule": 2, "cacheControl": "s-maxage=60, stale-while-revalidate=540" },
    { "path": "/blog/drafts/x", "rule": 1, "cacheControl": "s-maxage=5" },
    { "path": "/blog", "rule": 4, "cacheControl": "s-maxage=1" },
    { "path": "/docs/guide", "rule": 3, "cacheControl": "s-maxage=10, stale-while-revalidate=1" },
    { "path": "/docs/guide/", "rule": 4, "cacheControl": "s-maxage=1" },
    { "path": "/other", "rule": 4, "cacheControl": "s-maxage=1" }
  ],
  "invalid": [
    { "reason": "a path that does not start with a slash", "rule": { "path": "blog", "revalidate": 10 } },
    { "reason": "a wildcard that is not a whole final segment", "rule": { "path": "/blog*", "revalidate": 10 } },
    { "reason": "a wildcard before the final segment", "rule": { "path": "/*/post", "revalidate": 10 } },
    { "reason": "a query in the path", "rule": { "path": "/blog?x=1", "revalidate": 10 } },
    { "reason": "a revalidate that is not positive", "rule": { "path": "/blog", "revalidate": 0 } },
    { "reason": "a revalidate that is not a whole number", "rule": { "path": "/blog", "revalidate": 1.5 } },
    { "reason": "an expire that does not outlast revalidate", "rule": { "path": "/blog", "revalidate": 10, "expire": 10 } },
    { "reason": "an expire that is not a whole number", "rule": { "path": "/blog", "revalidate": 10, "expire": 20.5 } }
  ]
}
