{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "releases-store",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BOOTSTRAP_SECRET": "dev-secret"
  },
  "r2_buckets": [
    {
      "binding": "OCEL_CACHE_STORE",
      "bucket_name": "ocel-cache-store"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RELEASES_DO",
        "class_name": "ReleasesStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ReleasesStore"]
    }
  ]
}
