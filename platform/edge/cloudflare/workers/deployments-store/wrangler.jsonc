{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deployments-store",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "BOOTSTRAP_SECRET": "dev-secret",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DEPLOYMENTS_DO",
        "class_name": "DeploymentsStore",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeploymentsStore"],
    },
  ],
}
