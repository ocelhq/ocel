{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": ["nodejs_compat"],
  "define": {
    "__dirname": "\"/\"",
    "__filename": "\"/index.js\""
  },
  "vars": {
    "OCEL_APP": "web",
    "OCEL_SLUG": "dev",
    "OCEL_ORIGIN": "{\"reach\":{\"kind\":\"sigv4\",\"service\":\"lambda\",\"region\":\"eu-west-2\",\"accessKeyId\":\"AKIAEXAMPLE\",\"secretAccessKey\":\"secretkey\"},\"throttle\":{\"status\":429,\"header\":\"x-amzn-errortype\"}}",
    "OCEL_PURGE_BUDGET": "{\"purgesPerMinute\":5,\"tagsPerPurge\":100}"
  },
  "services": [{ "binding": "RELEASES", "service": "releases-store" }],
  "worker_loaders": [{ "binding": "LOADER" }],
  "durable_objects": {
    "bindings": [{ "name": "PURGE_QUEUE", "class_name": "PurgeQueue" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["PurgeQueue"] }]
}
