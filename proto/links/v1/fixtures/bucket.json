{
  "name": "bucket--uploads",
  "bucket": {
    "bucket": "shop-prod-uploads-t7d8e9f0"
  },
  "grants": [
    {
      "label": "objects",
      "actions": [
        "s3:DeleteObject",
        "s3:GetObject",
        "s3:PutObject",
        "s3:PutObjectTagging"
      ],
      "resources": ["arn:aws:s3:::shop-prod-uploads-t7d8e9f0/*"]
    },
    {
      "label": "listing",
      "actions": ["s3:ListBucket"],
      "resources": ["arn:aws:s3:::shop-prod-uploads-t7d8e9f0"]
    },
    {
      "label": "sessions",
      "actions": ["dynamodb:GetItem", "dynamodb:PutItem"],
      "resources": ["arn:aws:dynamodb:us-east-1:111122223333:table/ocel-state"],
      "conditions": [
        {
          "operator": "ForAllValues:StringLike",
          "key": "dynamodb:LeadingKeys",
          "values": ["PROJECT#shop#ENV#prod#SESSION#*"]
        }
      ]
    }
  ]
}
