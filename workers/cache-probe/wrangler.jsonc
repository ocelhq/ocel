{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ocel-cache-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  "routes": [
    { "pattern": "probe.ocel.dev/*", "zone_name": "ocel.dev" },
    { "pattern": "probe.ocel.site/*", "zone_name": "ocel.site" },
  ],
}
