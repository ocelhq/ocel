{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ocel-cache-probe",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "observability": {
    "enabled": true,
  },
  "upload_source_maps": true,
  // The Cache API is inert on workers.dev, so a deploy that answers only there
  // measures nothing. Fill in the zone this probe should serve from before
  // deploying — a zone route, which is how cloud/edge/cloudflare attaches a real
  // Ocel app with domains. See README.md.
  // "routes": [{ "pattern": "probe.example.com/*", "zone_name": "example.com" }],
}
