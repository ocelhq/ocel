{
  "name": "@ocel/transforms",
  "version": "0.0.0",
  "private": false,
  "type": "module",
  "description": "Patches the underlying cloud resources ocel provisions, typed from the provider's own SDK",
  "files": [
    "dist/",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./aws": {
      "types": "./dist/aws/index.d.ts",
      "import": "./dist/aws/index.js"
    },
    "./vps": {
      "types": "./dist/vps/index.d.ts",
      "import": "./dist/vps/index.js"
    },
    "./run": {
      "types": "./dist/run.d.ts",
      "import": "./dist/run.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p tsconfig.typetests.json && tsc --noEmit -p tsconfig.typetests-empty.json && tsc --noEmit -p tsconfig.typetests-open.json"
  },
  "dependencies": {
    "@pulumi/aws": "7.36.0",
    "@pulumi/pulumi": "^3.259.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocelhq/ocel.git",
    "directory": "packages/ocel-transforms"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
