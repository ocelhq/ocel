{
  "name": "@ocel/sst",
  "version": "0.0.1-alpha.0",
  "private": true,
  "type": "module",
  "description": "Publishes SST-defined resources as ocel links, as a side effect of `sst deploy`",
  "exports": {
    ".": "./src/index.ts",
    "./record": "./src/record.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc"
  },
  "optionalDependencies": {
    "@ocel/provider-aws-darwin-arm64": "workspace:^",
    "@ocel/provider-aws-darwin-x64": "workspace:^",
    "@ocel/provider-aws-linux-x64": "workspace:^",
    "@ocel/provider-aws-win32-x64": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "license": "MIT"
}
