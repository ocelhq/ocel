{
  "name": "@ocel/sst",
  "version": "0.0.5",
  "private": false,
  "type": "module",
  "description": "Publishes SST-defined resources as ocel bindings and SST outputs as ocel variables",
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@ocel/cli": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@ocel/cli": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ocel/cli": "workspace:^",
    "@types/node": "^20",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocelhq/ocel.git",
    "directory": "packages/ocel-sst"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
