{
  "name": "@ocel/sveltekit",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "description": "The SvelteKit adapter that builds an app into what ocel deploys",
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "files/",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "bun build.mjs && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/nft": "^0.27.4"
  },
  "peerDependencies": {
    "@sveltejs/kit": "^2.31.0 || ^3.0.0"
  },
  "devDependencies": {
    "@framework/node-build": "workspace:*",
    "@platform/edge-contract": "workspace:*",
    "@sveltejs/kit": "3.0.1",
    "@types/node": "^20",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocelhq/ocel.git",
    "directory": "packages/sveltekit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
