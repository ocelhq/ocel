{
  "name": "ocel",
  "version": "0.0.1-alpha.0",
  "type": "module",
  "description": "ocel runtime sdk — turns cloud infrastructure into function calls",
  "files": [
    "dist/",
    "README.md"
  ],
  "exports": {
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js"
    },
    "./dns": {
      "types": "./dist/dns.d.ts",
      "import": "./dist/dns.js"
    },
    "./providers/aws": {
      "types": "./dist/providers/aws/index.d.ts",
      "import": "./dist/providers/aws/index.js"
    },
    "./providers/aws/edge": {
      "types": "./dist/providers/aws/edge.d.ts",
      "import": "./dist/providers/aws/edge.js"
    },
    "./providers/aws/dns": {
      "types": "./dist/providers/aws/dns.d.ts",
      "import": "./dist/providers/aws/dns.js"
    },
    "./providers/aws/transform": {
      "types": "./dist/providers/aws/transform/index.d.ts",
      "import": "./dist/providers/aws/transform/index.js"
    },
    "./providers/aws/transform/run": {
      "types": "./dist/providers/aws/transform/run.d.ts",
      "import": "./dist/providers/aws/transform/run.js"
    },
    "./providers/gcp": {
      "types": "./dist/providers/gcp/index.d.ts",
      "import": "./dist/providers/gcp/index.js"
    },
    "./providers/vps": {
      "types": "./dist/providers/vps/index.d.ts",
      "import": "./dist/providers/vps/index.js"
    },
    "./env": {
      "types": "./dist/env/index.d.ts",
      "edge-light": "./dist/env/edge.js",
      "workerd": "./dist/env/edge.js",
      "worker": "./dist/env/edge.js",
      "import": "./dist/env/index.js"
    },
    "./env/client": {
      "types": "./dist/env/client.d.ts",
      "import": "./dist/env/client.js"
    },
    "./env/schema": {
      "types": "./dist/env/schema.d.ts",
      "import": "./dist/env/schema.js"
    },
    "./postgres": {
      "types": "./dist/postgres/index.d.ts",
      "import": "./dist/postgres/index.js"
    },
    "./blob": {
      "types": "./dist/blob/index.d.ts",
      "import": "./dist/blob/index.js"
    },
    "./blob/next": {
      "types": "./dist/blob/next.d.ts",
      "import": "./dist/blob/next.js"
    },
    "./blob/hono": {
      "types": "./dist/blob/hono.d.ts",
      "import": "./dist/blob/hono.js"
    },
    "./blob/express": {
      "types": "./dist/blob/express.d.ts",
      "import": "./dist/blob/express.js"
    },
    "./blob/client": {
      "types": "./dist/blob/client.d.ts",
      "import": "./dist/blob/client.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json && tsc --noEmit -p tsconfig.typetests.json && tsc --noEmit -p tsconfig.typetests-empty.json && tsc --noEmit -p tsconfig.typetests-open.json && tsc --noEmit -p tsconfig.typetests-config.json"
  },
  "license": "MIT",
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@connectrpc/connect": "^2.1.2",
    "@connectrpc/connect-node": "^2.1.2",
    "@standard-schema/spec": "^1.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.160",
    "@types/express": "~5.0.0",
    "@types/pg": "^8.20.0",
    "express": "~5.0.0",
    "hono": "~4.11.1",
    "next": "16.2.10",
    "pg": "^8.22.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "@types/express": ">=5.0.0",
    "express": ">=5.0.0",
    "hono": ">=4.11.1",
    "next": ">=14",
    "pg": "^8.22.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    },
    "@types/express": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
