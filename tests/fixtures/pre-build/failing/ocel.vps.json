{
  "$schema": "https://ocel.dev/schema/0.0.1/ocel.schema.json",
  "slug": "pre-build-failing",
  "provider": {
    "vps": {
      "ssh": {
        "host": "${OCEL_VPS_HOST}",
        "user": "${OCEL_VPS_USER}",
        "identityFile": "${OCEL_VPS_IDENTITY_FILE}"
      }
    }
  },
  "apps": [
    {
      "name": "web",
      "path": ".",
      "compute": "container",
      "health": {
        "path": "/health"
      }
    }
  ],
  "lifecycle": {
    "preBuild": "echo 'migration refused: the schema is behind' >&2; exit 3"
  }
}
