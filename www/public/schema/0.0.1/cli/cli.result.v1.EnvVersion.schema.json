{
  "$defs": {
    "cli.result.v1.EnvVersion.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(created_at)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "createdAt": {
          "default": "",
          "type": "string"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "title": "Env Version",
      "type": "object"
    }
  },
  "$id": "https://ocel.dev/schema/0.0.1/cli/cli.result.v1.EnvVersion.schema.json",
  "$ref": "#/$defs/cli.result.v1.EnvVersion.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
