{
  "$defs": {
    "cli.stream.v1.MissingGroup.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "key": {
          "default": "",
          "minLength": 1,
          "pattern": "^[^#\\x00-\\x1f\\x7f]*$",
          "type": "string"
        }
      },
      "title": "Missing Group",
      "type": "object"
    },
    "cli.stream.v1.MissingVariable.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "folder": {
          "default": "",
          "pattern": "^(/[^/#\\x00-\\x1f\\x7f]+)*$",
          "type": "string"
        },
        "group": {
          "default": "",
          "pattern": "^[^#\\x00-\\x1f\\x7f]*$",
          "type": "string"
        },
        "key": {
          "default": "",
          "type": "string"
        },
        "reason": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Missing Variable",
      "type": "object"
    },
    "cli.stream.v1.MissingVariables.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cells": {
          "items": {
            "$ref": "#/$defs/cli.stream.v1.MissingVariable.jsonschema.json"
          },
          "type": "array"
        },
        "groups": {
          "items": {
            "$ref": "#/$defs/cli.stream.v1.MissingGroup.jsonschema.json"
          },
          "type": "array"
        },
        "remedy": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Missing Variables",
      "type": "object"
    },
    "cli.stream.v1.WaitingEvent.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "input": {
          "$ref": "#/$defs/runner.v1.JobInput.jsonschema.json"
        },
        "missing": {
          "$ref": "#/$defs/cli.stream.v1.MissingVariables.jsonschema.json"
        },
        "url": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Waiting Event",
      "type": "object"
    },
    "runner.v1.Confirmation.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "finding": {
          "default": "",
          "type": "string"
        },
        "question": {
          "default": "",
          "minLength": 1,
          "type": "string"
        }
      },
      "title": "Confirmation",
      "type": "object"
    },
    "runner.v1.JobInput.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "confirmation": {
          "$ref": "#/$defs/runner.v1.Confirmation.jsonschema.json"
        },
        "id": {
          "default": "",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        "variables": {
          "$ref": "#/$defs/runner.v1.VariablesNeeded.jsonschema.json"
        }
      },
      "title": "Job Input",
      "type": "object",
      "allOf": [
        {
          "oneOf": [
            {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "variables"
                    ]
                  },
                  {
                    "required": [
                      "confirmation"
                    ]
                  }
                ]
              }
            },
            {
              "required": [
                "variables"
              ]
            },
            {
              "required": [
                "confirmation"
              ]
            }
          ]
        }
      ]
    },
    "runner.v1.NeededGroup.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "key": {
          "default": "",
          "minLength": 1,
          "pattern": "^[^#\\x00-\\x1f\\x7f]*$",
          "type": "string"
        }
      },
      "title": "Needed Group",
      "type": "object"
    },
    "runner.v1.NeededVariable.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "description": {
          "default": "",
          "type": "string"
        },
        "folder": {
          "default": "",
          "pattern": "^(/[^/#\\x00-\\x1f\\x7f]+)*$",
          "type": "string"
        },
        "group": {
          "default": "",
          "pattern": "^[^#\\x00-\\x1f\\x7f]*$",
          "type": "string"
        },
        "key": {
          "default": "",
          "minLength": 1,
          "pattern": "^[^#\\x00-\\x1f\\x7f]*$",
          "type": "string"
        },
        "reason": {
          "default": "",
          "type": "string"
        },
        "secret": {
          "default": false,
          "type": "boolean"
        }
      },
      "title": "Needed Variable",
      "type": "object"
    },
    "runner.v1.VariablesNeeded.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "groups": {
          "items": {
            "$ref": "#/$defs/runner.v1.NeededGroup.jsonschema.json"
          },
          "type": "array"
        },
        "tier": {
          "anyOf": [
            {
              "enum": [
                "TIER_PREVIEW",
                "TIER_PRODUCTION"
              ],
              "type": "string"
            },
            {
              "maximum": 2,
              "minimum": 1,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Tier"
        },
        "variables": {
          "items": {
            "$ref": "#/$defs/runner.v1.NeededVariable.jsonschema.json"
          },
          "minItems": 1,
          "type": "array"
        }
      },
      "title": "Variables Needed",
      "type": "object"
    }
  },
  "$id": "https://ocel.dev/schema/cli/cli.stream.v1.WaitingEvent.schema.json",
  "$ref": "#/$defs/cli.stream.v1.WaitingEvent.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
