{
  "name": "ocelhq",
  "description": "Ocel monorepo",
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "gen": "buf generate --template buf.gen.go.yaml && pnpm buf generate --template buf.gen.ts.yaml",
    "dev:cli": "go tool air",
    "ci:version": "changeset version && pnpm install --lockfile-only",
    "lint": "biome check",
    "format": "biome format --write",
    "prepare": "husky"
  },
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "dependencies": {
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protobuf": "^2.12.1",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@ocel/provider-aws": "workspace:^",
    "@ocel/provider-vps": "workspace:^",
    "@types/node": "^26.1.1",
    "husky": "9.1.7",
    "lint-staged": "17.4.1",
    "ocel": "workspace:*",
    "turbo": "^2.10.12",
    "zod": "^4.4.3"
  }
}
