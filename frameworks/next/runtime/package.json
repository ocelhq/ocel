    "./cache-store": "./src/cache-store.mts",
    "./host": "./src/host.mts",
    "./incremental-cache": "./src/incremental-cache.mts",
    "./origin-tags": "./src/origin-tags.mts",
    "./project-manifest": "./src/project-manifest.mts",
    "./revalidation-signal": "./src/revalidation-signal.mts",
    "./tag-clock": "./src/tag-clock.mts",
    "./tags-manifest": "./src/tags-manifest.mts",
    "./test-support/*": "./test-support/*.mts",
    "./use-cache-entry": "./src/use-cache-entry.mts",
