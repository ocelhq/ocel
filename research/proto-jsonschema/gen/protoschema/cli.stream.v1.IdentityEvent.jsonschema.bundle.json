{
  "$defs": {
    "cli.stream.v1.IdentityEvent.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "edge": {
          "$ref": "#/$defs/cli.stream.v1.Party.jsonschema.json"
        },
        "origin": {
          "$ref": "#/$defs/cli.stream.v1.Party.jsonschema.json"
        },
        "project": {
          "default": "",
          "type": "string"
        },
        "tier": {
          "anyOf": [
            {
              "pattern": "^TIER_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "TIER_PREVIEW",
                "TIER_PRODUCTION"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Tier"
        }
      },
      "title": "Identity Event",
      "type": "object"
    },
    "cli.stream.v1.Party.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "account": {
          "default": "",
          "type": "string"
        },
        "location": {
          "default": "",
          "type": "string"
        },
        "principal": {
          "default": "",
          "type": "string"
        },
        "vendor": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Party",
      "type": "object"
    }
  },
  "$id": "cli.stream.v1.IdentityEvent.jsonschema.bundle.json",
  "$ref": "#/$defs/cli.stream.v1.IdentityEvent.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
