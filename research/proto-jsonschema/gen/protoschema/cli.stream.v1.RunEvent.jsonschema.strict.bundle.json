        "phase": {
          "enum": [
            "PHASE_UNSPECIFIED",
            "PHASE_CHECK",
            "PHASE_BUILD",
            "PHASE_PLAN",
            "PHASE_PROVISION",
            "PHASE_DEPLOY",
            "PHASE_PROMOTE",
            "PHASE_DESTROY"
