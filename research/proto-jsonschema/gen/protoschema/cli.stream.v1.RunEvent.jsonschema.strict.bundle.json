      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string"
        },
        "folder": {
          "pattern": "^(/[^/#[:cntrl:]]+)*$",
          "type": "string"
        },
        "group": {
          "pattern": "^[^#[:cntrl:]]*$",
          "type": "string"
