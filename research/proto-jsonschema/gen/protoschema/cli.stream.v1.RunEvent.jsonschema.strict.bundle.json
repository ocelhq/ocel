        "spanId": {
          "maxLength": 12,
          "minLength": 11,
          "pattern": "^[A-Za-z0-9+/]*={0,2}$",
          "type": "string"
        },
        "started": {
          "$ref": "#/$defs/common.progress.v1.Started.jsonschema.strict.json"
        },
        "subject": {
          "type": "string"
        },
        "time": {
          "$ref": "#/$defs/google.protobuf.Timestamp.jsonschema.strict.json"
