{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "$ref": "#/definitions/RunSummary",
    "definitions": {
        "RunSummary": {
            "properties": {
                "success": {
                    "type": "boolean"
                },
                "detail": {
                    "type": "string"
                },
                "durationMs": {
                    "type": "string"
                },
                "logPath": {
                    "type": "string"
                },
                "headline": {
                    "type": "string"
                },
                "urlNotes": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "propagation": {
                    "$ref": "#/definitions/common.progress.v1.Propagation",
                    "additionalProperties": false
                },
                "interrupted": {
                    "type": "boolean"
                },
                "apps": {
                    "items": {
                        "$ref": "#/definitions/common.progress.v1.AppResult"
                    },
                    "additionalProperties": false,
                    "type": "array"
                },
                "missing": {
                    "$ref": "#/definitions/cli.stream.v1.MissingVariables",
                    "additionalProperties": false
                },
                "changeStarted": {
                    "type": "boolean"
                },
                "tier": {
                    "enum": [
                        "TIER_UNSPECIFIED",
                        "TIER_PREVIEW",
                        "TIER_PRODUCTION"
                    ],
                    "type": "string",
                    "title": "Tier"
                },
                "origin": {
                    "$ref": "#/definitions/cli.stream.v1.Party",
                    "additionalProperties": false
                },
                "promotionId": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Run Summary"
        },
        "cli.stream.v1.MissingGroup": {
            "properties": {
                "key": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Missing Group"
        },
        "cli.stream.v1.MissingVariable": {
            "properties": {
                "key": {
                    "type": "string"
                },
                "folder": {
                    "type": "string"
                },
                "reason": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "group": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Missing Variable"
        },
        "cli.stream.v1.MissingVariables": {
            "properties": {
                "cells": {
                    "items": {
                        "$ref": "#/definitions/cli.stream.v1.MissingVariable"
                    },
                    "additionalProperties": false,
                    "type": "array"
                },
                "remedy": {
                    "type": "string"
                },
                "groups": {
                    "items": {
                        "$ref": "#/definitions/cli.stream.v1.MissingGroup"
                    },
                    "additionalProperties": false,
                    "type": "array"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Missing Variables"
        },
        "cli.stream.v1.Party": {
            "properties": {
                "vendor": {
                    "type": "string"
                },
                "account": {
                    "type": "string"
                },
                "principal": {
                    "type": "string"
                },
                "location": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Party"
        },
        "common.progress.v1.AppResult": {
            "properties": {
                "app": {
                    "type": "string"
                },
                "outcome": {
                    "enum": [
                        "APP_OUTCOME_UNSPECIFIED",
                        "APP_OUTCOME_SUCCEEDED",
                        "APP_OUTCOME_FAILED",
                        "APP_OUTCOME_NOT_RUN"
                    ],
                    "type": "string",
                    "title": "App Outcome"
                },
                "error": {
                    "type": "string"
                },
                "urls": {
                    "items": {
                        "type": "string"
                    },
                    "type": "array"
                },
                "deploymentUrl": {
                    "type": "string"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "App Result"
        },
        "common.progress.v1.Propagation": {
            "properties": {
                "typicalMs": {
                    "type": "string"
                },
                "published": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false,
            "type": "object",
            "title": "Propagation"
        }
    }
}