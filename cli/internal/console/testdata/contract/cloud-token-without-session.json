{
  "name": "cloud-token-without-session",
  "request": {
    "method": "POST",
    "path": "/api/connect/console.v1.ConsoleService/IssueCloudToken",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "scopes": [
        "cloud.apps.read"
      ],
      "organizationId": "{{organization.id}}"
    }
  },
  "response": {
    "status": 401,
    "body": {
      "code": "unauthenticated",
      "message": "sign in to the console first"
    }
  },
  "dynamic": [
    "$.message"
  ]
}
