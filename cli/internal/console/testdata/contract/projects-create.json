{
  "name": "projects-create",
  "request": {
    "method": "POST",
    "path": "/api/projects",
    "headers": {
      "Authorization": "Bearer {{session.token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "name": "Shop",
      "slug": "shop"
    }
  },
  "response": {
    "status": 201,
    "body": {
      "id": "0199b5c4-0000-7000-8000-00000000c0de",
      "organizationId": "{{organization.id}}",
      "name": "Shop",
      "slug": "shop",
      "description": null
    }
  },
  "dynamic": [
    "$.id"
  ]
}
