{
  "name": "cloud-token",
  "request": {
    "method": "POST",
    "path": "/api/connect/console.v1.ConsoleService/IssueCloudToken",
    "headers": {
      "Authorization": "Bearer {{session.token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "scopes": [
        "cloud.apps.read"
      ],
      "organizationId": "{{organization.id}}"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "token": "eyJhbGciOiJFZERTQSJ9.eyJhdWQiOiJvY2VsLWNsb3VkIn0.c2lnbmF0dXJl",
      "expiresAt": "2026-02-01T03:09:05Z"
    }
  },
  "dynamic": [
    "$.token",
    "$.expiresAt"
  ]
}
