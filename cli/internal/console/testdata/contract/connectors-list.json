{
  "name": "connectors-list",
  "request": {
    "method": "GET",
    "path": "/api/connectors",
    "headers": {
      "Authorization": "Bearer {{session.token}}"
    },
    "body": null
  },
  "response": {
    "status": 200,
    "body": [
      {
        "id": "{{connector.id}}",
        "organizationId": "{{organization.id}}",
        "target": "vps/sha256:abc/ocel",
        "vendor": "vps",
        "compute": "container",
        "reach": "dial",
        "url": "https://connector.example.test",
        "publicKey": "{{connector.publicKey}}",
        "tlsPin": null,
        "version": "0.0.0-alpha",
        "capabilities": [
          "variables.read"
        ],
        "connectedAt": "2026-01-02T03:04:05.678Z",
        "lastSeenAt": "2026-01-02T03:04:05.678Z",
        "lastDenied": {
          "verb": "set",
          "at": "2026-01-02T03:04:05.678Z",
          "message": "the token has no variables.write scope"
        },
        "online": true
      }
    ]
  },
  "dynamic": [
    "$[0].connectedAt",
    "$[0].lastSeenAt"
  ]
}
