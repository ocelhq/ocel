{
  "name": "projects-create-conflict",
  "request": {
    "method": "POST",
    "path": "/api/projects",
    "headers": {
      "Authorization": "Bearer {{session.token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "name": "Shop",
      "slug": "shop"
    }
  },
  "response": {
    "status": 409,
    "body": {
      "error": "A project with this slug already exists in this organization"
    }
  }
}
