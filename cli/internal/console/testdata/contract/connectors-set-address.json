{
  "name": "connectors-set-address",
  "request": {
    "method": "PATCH",
    "path": "/api/connectors/{{connector.id}}",
    "headers": {
      "Authorization": "Bearer {{session.token}}",
      "Content-Type": "application/json"
    },
    "body": {
      "url": "https://connector.example.test",
      "publicKey": "{{connector.publicKey}}",
      "compute": "container"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "id": "{{connector.id}}",
      "organizationId": "{{organization.id}}",
      "target": "vps/sha256:abc/ocel",
      "vendor": "vps",
      "compute": "container",
      "reach": "dial",
      "url": "https://connector.example.test",
      "publicKey": "{{connector.publicKey}}",
      "tlsPin": null,
      "version": null,
      "capabilities": [],
      "connectedAt": null,
      "lastSeenAt": null,
      "lastDenied": null,
      "online": false
    }
  }
}
