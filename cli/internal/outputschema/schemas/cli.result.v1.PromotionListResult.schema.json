{
  "$defs": {
    "cli.result.v1.PromotionListResult.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "promotions": {
          "items": {
            "$ref": "#/$defs/cli.result.v1.PromotionSummary.jsonschema.json"
          },
          "type": "array"
        }
      },
      "title": "Promotion List Result",
      "type": "object"
    },
    "cli.result.v1.PromotionSummary.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(created_at)$": {
          "default": "",
          "type": "string"
        },
        "^(promotion_id)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "builds": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "createdAt": {
          "default": "",
          "type": "string"
        },
        "promotionId": {
          "default": "",
          "type": "string"
        },
        "state": {
          "anyOf": [
            {
              "pattern": "^PROMOTION_STATE_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "PROMOTION_STATE_ACTIVE",
                "PROMOTION_STATE_UNPROMOTED",
                "PROMOTION_STATE_SUPERSEDED"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Promotion State"
        },
        "tag": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Promotion Summary",
      "type": "object"
    }
  },
  "$id": "https://ocel.dev/schema/0.0.1/cli/cli.result.v1.PromotionListResult.schema.json",
  "$ref": "#/$defs/cli.result.v1.PromotionListResult.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
