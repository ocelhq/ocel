{
  "$defs": {
    "cli.result.v1.ProjectListResult.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "projects": {
          "items": {
            "$ref": "#/$defs/cli.result.v1.ProjectSummary.jsonschema.json"
          },
          "type": "array"
        }
      },
      "title": "Project List Result",
      "type": "object"
    },
    "cli.result.v1.ProjectSummary.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(last_deployed_at)$": {
          "default": "",
          "type": "string"
        },
        "^(production_promotion_id)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "edge": {
          "default": "",
          "type": "string"
        },
        "lastDeployedAt": {
          "default": "",
          "type": "string"
        },
        "previews": {
          "anyOf": [
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "productionPromotionId": {
          "default": "",
          "type": "string"
        },
        "slug": {
          "default": "",
          "type": "string"
        },
        "tiers": {
          "items": {
            "anyOf": [
              {
                "enum": [
                  "TIER_UNSPECIFIED",
                  "TIER_PREVIEW",
                  "TIER_PRODUCTION"
                ],
                "type": "string"
              },
              {
                "maximum": 2147483647,
                "minimum": -2147483648,
                "type": "integer"
              }
            ],
            "title": "Tier"
          },
          "type": "array"
        }
      },
      "title": "Project Summary",
      "type": "object"
    }
  },
  "$id": "https://ocel.dev/schema/cli/cli.result.v1.ProjectListResult.schema.json",
  "$ref": "#/$defs/cli.result.v1.ProjectListResult.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
