{
  "$defs": {
    "cli.result.v1.EnvCoordinate.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "default": "",
          "type": "string"
        },
        "folder": {
          "default": "",
          "type": "string"
        },
        "key": {
          "default": "",
          "type": "string"
        },
        "project": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Env Coordinate",
      "type": "object"
    },
    "cli.result.v1.EnvWrittenValue.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "coordinate": {
          "$ref": "#/$defs/cli.result.v1.EnvCoordinate.jsonschema.json"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "title": "Env Written Value",
      "type": "object"
    }
  },
  "$id": "https://ocel.dev/schema/cli/cli.result.v1.EnvWrittenValue.schema.json",
  "$ref": "#/$defs/cli.result.v1.EnvWrittenValue.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
