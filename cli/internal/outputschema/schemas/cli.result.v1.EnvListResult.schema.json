{
  "$defs": {
    "cli.result.v1.EnvCoordinate.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "default": "",
          "type": "string"
        },
        "folder": {
          "default": "",
          "type": "string"
        },
        "key": {
          "default": "",
          "type": "string"
        },
        "project": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Env Coordinate",
      "type": "object"
    },
    "cli.result.v1.EnvListResult.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "tier": {
          "anyOf": [
            {
              "pattern": "^TIER_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": ["TIER_PREVIEW", "TIER_PRODUCTION"],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Tier"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/cli.result.v1.EnvValueSummary.jsonschema.json"
          },
          "type": "array"
        }
      },
      "title": "Env List Result",
      "type": "object"
    },
    "cli.result.v1.EnvValueSummary.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(env_source)$": {
          "default": "",
          "type": "string"
        },
        "^(updated_at)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "coordinate": {
          "$ref": "#/$defs/cli.result.v1.EnvCoordinate.jsonschema.json"
        },
        "description": {
          "default": "",
          "type": "string"
        },
        "envSource": {
          "default": "",
          "type": "string"
        },
        "group": {
          "default": "",
          "type": "string"
        },
        "orphaned": {
          "default": false,
          "type": "boolean"
        },
        "size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "target": {
          "$ref": "#/$defs/cli.result.v1.EnvCoordinate.jsonschema.json"
        },
        "updatedAt": {
          "default": "",
          "type": "string"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "title": "Env Value Summary",
      "type": "object"
    }
  },
  "$id": "https://ocel.dev/schema/0.0.1/cli/cli.result.v1.EnvListResult.schema.json",
  "$ref": "#/$defs/cli.result.v1.EnvListResult.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
