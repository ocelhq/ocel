{
  "$defs": {
    "cli.result.v1.PhysicalResource.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(console_url)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "consoleUrl": {
          "default": "",
          "type": "string"
        },
        "id": {
          "default": "",
          "type": "string"
        },
        "kind": {
          "default": "",
          "type": "string"
        },
        "location": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Physical Resource",
      "type": "object"
    },
    "cli.result.v1.ProjectResourceGroup.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "default": "",
          "type": "string"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/cli.result.v1.PhysicalResource.jsonschema.json"
          },
          "type": "array"
        },
        "stack": {
          "default": "",
          "type": "string"
        },
        "tier": {
          "anyOf": [
            {
              "pattern": "^TIER_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "TIER_PREVIEW",
                "TIER_PRODUCTION"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Tier"
        }
      },
      "title": "Project Resource Group",
      "type": "object"
    }
  },
  "$id": "https://ocel.dev/schema/cli/cli.result.v1.ProjectResourceGroup.schema.json",
  "$ref": "#/$defs/cli.result.v1.ProjectResourceGroup.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
