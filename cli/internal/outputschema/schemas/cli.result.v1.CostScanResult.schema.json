        },
        "monthlyUsage": {
          "default": "",
          "type": "string"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "profile": {
          "anyOf": [
            {
              "enum": [
                "PROFILE_LIGHT",
                "PROFILE_MODERATE",
                "PROFILE_HEAVY"
              ],
              "type": "string"
            },
            {
              "maximum": 3,
              "minimum": 1,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Profile"
        },
        "resources": {
          "items": {
            "$ref": "#/$defs/common.cost.v1.ResourceEstimate.jsonschema.json"
