      "type": "object"
    },
    "common.cost.v1.ResourceEstimate.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(monthly_fixed)$": {
          "default": "",
          "type": "string"
        },
        "^(monthly_usage)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "components": {
          "items": {
            "$ref": "#/$defs/common.cost.v1.CostComponent.jsonschema.json"
          },
          "type": "array"
