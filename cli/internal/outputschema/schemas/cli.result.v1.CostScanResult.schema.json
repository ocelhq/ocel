{
  "$defs": {
    "cli.result.v1.CostScanResult.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "assumptions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "estimate": {
          "$ref": "#/$defs/common.cost.v1.Estimate.jsonschema.json"
        },
        "resources": {
          "$ref": "#/$defs/common.cost.v1.ResourceSet.jsonschema.json"
        }
      },
      "title": "Cost Scan Result",
      "type": "object"
    },
    "common.cost.v1.CatalogVersion.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "service": {
          "default": "",
          "type": "string"
        },
        "vendor": {
          "default": "",
          "type": "string"
        },
        "version": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Catalog Version",
      "type": "object"
    },
    "common.cost.v1.CostComponent.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(depends_on_unknown)$": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "^(monthly_cost)$": {
          "default": "",
          "type": "string"
        },
        "^(monthly_quantity)$": {
          "default": "",
          "type": "string"
        },
        "^(price_detail)$": {
          "default": "",
          "type": "string"
        },
        "^(price_source)$": {
          "default": "",
          "type": "string"
        },
        "^(price_status)$": {
          "anyOf": [
            {
              "enum": [
                "PRICE_STATUS_PRICED",
                "PRICE_STATUS_UNKNOWN_INPUT",
                "PRICE_STATUS_MISSING",
                "PRICE_STATUS_AMBIGUOUS",
                "PRICE_STATUS_UNAVAILABLE"
              ],
              "type": "string"
            },
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Price Status"
        },
        "^(unit_price)$": {
          "default": "",
          "type": "string"
        },
        "^(usage_based)$": {
          "default": false,
          "type": "boolean"
        }
      },
      "properties": {
        "assumption": {
          "default": "",
          "type": "string"
        },
        "dependsOnUnknown": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "monthlyCost": {
          "default": "",
          "type": "string"
        },
        "monthlyQuantity": {
          "default": "",
          "type": "string"
        },
        "name": {
          "default": "",
          "type": "string"
        },
        "priceDetail": {
          "default": "",
          "type": "string"
        },
        "priceSource": {
          "default": "",
          "type": "string"
        },
        "priceStatus": {
          "anyOf": [
            {
              "enum": [
                "PRICE_STATUS_PRICED",
                "PRICE_STATUS_UNKNOWN_INPUT",
                "PRICE_STATUS_MISSING",
                "PRICE_STATUS_AMBIGUOUS",
                "PRICE_STATUS_UNAVAILABLE"
              ],
              "type": "string"
            },
            {
              "maximum": 5,
              "minimum": 1,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Price Status"
        },
        "sku": {
          "default": "",
          "type": "string"
        },
        "unit": {
          "default": "",
          "type": "string"
        },
        "unitPrice": {
          "default": "",
          "type": "string"
        },
        "usageBased": {
          "default": false,
          "type": "boolean"
        }
      },
      "title": "Cost Component",
      "type": "object"
    },
    "common.cost.v1.Coverage.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(no_price)$": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "^(supported_types)$": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "^(unsupported_types)$": {
          "additionalProperties": {
            "anyOf": [
              {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              {
                "pattern": "^[0-9]+$",
                "type": "string"
              }
            ]
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "properties": {
        "free": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "noPrice": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "supported": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "supportedTypes": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "unsupported": {
          "anyOf": [
            {
              "maximum": 4294967295,
              "minimum": 0,
              "type": "integer"
            },
            {
              "pattern": "^[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        },
        "unsupportedTypes": {
          "additionalProperties": {
            "anyOf": [
              {
                "maximum": 4294967295,
                "minimum": 0,
                "type": "integer"
              },
              {
                "pattern": "^[0-9]+$",
                "type": "string"
              }
            ]
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        }
      },
      "title": "Coverage",
      "type": "object"
    },
    "common.cost.v1.Estimate.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(monthly_fixed)$": {
          "default": "",
