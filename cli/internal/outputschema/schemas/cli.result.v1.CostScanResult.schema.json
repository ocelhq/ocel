      "properties": {
        "catalogs": {
          "items": {
            "$ref": "#/$defs/common.cost.v1.CatalogVersion.jsonschema.json"
          },
          "type": "array"
        },
        "coverage": {
          "$ref": "#/$defs/common.cost.v1.Coverage.jsonschema.json"
        },
        "currency": {
          "default": "",
          "type": "string"
        },
        "monthlyFixed": {
          "default": "",
