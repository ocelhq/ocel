        "type": {
          "default": "",
          "minLength": 1,
          "type": "string"
        },
        "unknown": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "vendor": {
          "default": "",
          "minLength": 1,
          "type": "string"
        }
      },
