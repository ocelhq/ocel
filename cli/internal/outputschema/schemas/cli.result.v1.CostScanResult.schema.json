        "monthlyUsage": {
          "default": "",
          "type": "string"
        },
        "resource": {
          "default": "",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "enum": [
                "STATUS_PRICED",
                "STATUS_FREE",
                "STATUS_UNSUPPORTED",
                "STATUS_NO_PRICE"
              ],
              "type": "string"
