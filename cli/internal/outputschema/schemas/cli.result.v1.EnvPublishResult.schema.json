{
  "$defs": {
    "cli.result.v1.EnvCoordinate.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "environment": {
          "default": "",
          "type": "string"
        },
        "folder": {
          "default": "",
          "type": "string"
        },
        "key": {
          "default": "",
          "type": "string"
        },
        "project": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Env Coordinate",
      "type": "object"
    },
    "cli.result.v1.EnvPublishResult.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "default": "",
          "type": "string"
        },
        "removed": {
          "items": {
            "$ref": "#/$defs/cli.result.v1.EnvCoordinate.jsonschema.json"
          },
          "type": "array"
        },
        "tier": {
          "anyOf": [
            {
              "pattern": "^TIER_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "TIER_PREVIEW",
                "TIER_PRODUCTION"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Tier"
        },
        "written": {
          "items": {
            "$ref": "#/$defs/cli.result.v1.EnvWrittenValue.jsonschema.json"
          },
          "type": "array"
        }
      },
      "title": "Env Publish Result",
      "type": "object"
    },
    "cli.result.v1.EnvWrittenValue.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "coordinate": {
          "$ref": "#/$defs/cli.result.v1.EnvCoordinate.jsonschema.json"
        },
        "version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "pattern": "^-?[0-9]+$",
              "type": "string"
            }
          ],
          "default": 0
        }
      },
      "title": "Env Written Value",
      "type": "object"
    }
  },
  "$id": "https://ocel.dev/schema/cli/cli.result.v1.EnvPublishResult.schema.json",
  "$ref": "#/$defs/cli.result.v1.EnvPublishResult.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
