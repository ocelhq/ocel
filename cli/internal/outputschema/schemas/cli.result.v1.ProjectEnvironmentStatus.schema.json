{
  "$defs": {
    "cli.result.v1.ProjectEnvironmentStatus.jsonschema.json": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "patternProperties": {
        "^(promotion_id)$": {
          "default": "",
          "type": "string"
        }
      },
      "properties": {
        "environment": {
          "default": "",
          "type": "string"
        },
        "promotionId": {
          "default": "",
          "type": "string"
        },
        "releases": {
          "additionalProperties": {
            "type": "string"
          },
          "propertyNames": {
            "type": "string"
          },
          "type": "object"
        },
        "tier": {
          "anyOf": [
            {
              "pattern": "^TIER_UNSPECIFIED$",
              "type": "string"
            },
            {
              "enum": [
                "TIER_PREVIEW",
                "TIER_PRODUCTION"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Tier"
        },
        "urls": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "Project Environment Status",
      "type": "object"
    }
  },
  "$id": "https://ocel.dev/schema/cli/cli.result.v1.ProjectEnvironmentStatus.schema.json",
  "$ref": "#/$defs/cli.result.v1.ProjectEnvironmentStatus.jsonschema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
