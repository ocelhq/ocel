            },
            {
              "enum": [
                "COMMAND_OUTPUT_RESULT",
                "COMMAND_OUTPUT_RUN_EVENTS"
              ],
              "type": "string"
            },
            {
              "maximum": 2147483647,
              "minimum": -2147483648,
              "type": "integer"
            }
          ],
          "default": 0,
          "title": "Command Output"
        },
        "path": {
          "default": "",
          "type": "string"
        }
      },
      "title": "Listed Command",
      "type": "object"
    }
  },
  "$id": "https://ocel.dev/schema/0.0.1/cli/cli.result.v1.ListedCommand.schema.json",
