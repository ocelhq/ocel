{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "types": [],
    "noEmit": true,
    "paths": { "@/*": ["./src/variable-editor/*"] }
  },
  "include": ["src/variable-editor/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
