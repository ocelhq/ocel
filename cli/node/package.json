{
  "name": "@cli/node",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "the node side of the ocel cli \u2014 bundled by build.mjs and embedded in the Go binary",
  "scripts": {
    "build": "bun build.mjs",
    "live": "go test -C .. -race -count=1 -timeout 30m -tags integration -run '^TestLive' ./...",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.variable-editor.json"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@framework/next-adapter": "workspace:^",
    "@framework/next-build": "workspace:^",
    "@framework/node-build": "workspace:^",
    "@ocelhq/theme": "0.1.0",
    "@ocelhq/variables-ui": "0.1.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8.5.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "^4.13.1",
    "tailwindcss": "^4",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  }
}
