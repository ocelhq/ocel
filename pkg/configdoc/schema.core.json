{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "description": "The JSON Schema this config is written against. ocel init writes the schema shipped with the CLI that created it.",
      "type": "string"
    },
    "allowDegraded": {
      "description": "The needs this project waives rather than have a deploy refused over.",
      "items": {
        "enum": [
          "edge-middleware",
          "edge-runtime",
          "ppr-resume",
          "edge-cache",
          "streaming"
        ],
        "type": "string"
      },
      "type": "array"
    },
    "apps": {
      "description": "The apps this project deploys. Left off, ocel detects one at the project root.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "arch": {
            "description": "The processor architecture an app's functions or container image are built for. Left off, what the provider runs the app on.",
            "enum": [
              "x86_64",
              "arm64"
            ],
            "type": "string"
          },
          "build": {
            "additionalProperties": false,
            "description": "How a container app's image is built.",
            "properties": {
              "command": {
                "description": "The command that builds the app inside the image. Left off, the app's own build script runs.",
                "type": "string"
              },
              "context": {
                "description": "The directory the image is built from, relative to the project. Left off, it is the workspace root the app belongs to.",
                "type": "string"
              },
              "dockerfile": {
                "description": "The Dockerfile to build from. A relative path resolves against the app's directory.",
                "type": "string"
              }
            },
            "title": "BuildConfig",
            "type": "object"
          },
          "compute": {
            "description": "What the app runs on: serverless functions packed per route, or one container image serving everything.",
            "enum": [
              "serverless",
              "container"
            ],
            "type": "string"
          },
          "domains": {
            "additionalProperties": false,
            "description": "The hostnames this app is served on.",
            "properties": {
              "production": {
                "description": "The hostnames production is served on.",
                "oneOf": [
                  {
                    "type": "string"
                  },
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  }
                ]
              }
            },
            "title": "AppDomainConfig",
            "type": "object"
          },
          "entrypoint": {
            "description": "The file the app is served from, when it is not the one ocel would detect.",
            "type": "string"
          },
          "folder": {
            "description": "The variables folder this app reads, when it does not read the project's own.",
            "type": "string"
          },
          "framework": {
            "description": "What a serverless app is built with, when ocel is not to read it off the app's own manifest.",
            "enum": [
              "node",
              "next",
              "go",
              "python",
              "rust"
            ],
            "type": "string"
          },
          "health": {
            "additionalProperties": false,
            "description": "How a container app is checked before it is served.",
            "properties": {
              "path": {
                "description": "The path the check requests, off the app's own root. Any 2xx answer means up. Left off, the check requests /.",
                "type": "string"
              }
            },
            "title": "HealthConfig",
            "type": "object"
          },
          "name": {
            "description": "The app's name. It is a label of every resource the app deploys and of its preview hostname, so it is a DNS label.",
            "type": "string"
          },
          "path": {
            "description": "The app's directory, relative to the config.",
            "type": "string"
          }
        },
        "required": [
          "name",
          "path"
        ],
        "title": "AppConfig",
        "type": "object"
      },
      "type": "array"
    },
    "bindings": {
      "additionalProperties": false,
      "description": "Resources this project declares that ocel binds instead of provisioning them itself. Keyed by resource type, then by the name the app declares. The value is \"@\" followed by the name a record your own infrastructure published, such as \"@warehouse\", and a name nothing has published refuses the deploy; or the record written inline, checked at deploy rather than provisioned, optionally keyed by the tier it serves.",
      "properties": {
        "bucket": {
          "additionalProperties": {
            "pattern": "^@\\S",
            "type": "string"
          },
          "description": "Each key is a bucket resource this project declares; its value is \"@\" followed by the name the record is published under, such as \"@warehouse\".",
          "type": "object"
        },
        "postgres": {
          "additionalProperties": {
            "oneOf": [
              {
                "pattern": "^@\\S",
                "type": "string"
              },
              {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "url": {
                        "additionalProperties": false,
                        "description": "The whole connection string, kept verbatim so its sslmode, options and pooler parameters reach the client.",
                        "properties": {
                          "$env": {
                            "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                            "pattern": "^[A-Z_][A-Z0-9_]*$",
                            "type": "string"
                          }
                        },
                        "required": [
                          "$env"
                        ],
                        "title": "VariableRef",
                        "type": "object"
                      }
                    },
                    "required": [
                      "url"
                    ],
                    "title": "PostgresUrlBinding",
                    "type": "object"
                  },
                  {
                    "additionalProperties": false,
                    "properties": {
                      "database": {
                        "description": "The database the app connects to.",
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "$env": {
                                "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                "pattern": "^[A-Z_][A-Z0-9_]*$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "$env"
                            ],
                            "title": "VariableRef",
                            "type": "object"
                          }
                        ]
                      },
                      "host": {
                        "description": "The server's hostname.",
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "$env": {
                                "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                "pattern": "^[A-Z_][A-Z0-9_]*$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "$env"
                            ],
                            "title": "VariableRef",
                            "type": "object"
                          }
                        ]
                      },
                      "password": {
                        "additionalProperties": false,
                        "description": "The role's password.",
                        "properties": {
                          "$env": {
                            "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                            "pattern": "^[A-Z_][A-Z0-9_]*$",
                            "type": "string"
                          }
                        },
                        "required": [
                          "$env"
                        ],
                        "title": "VariableRef",
                        "type": "object"
                      },
                      "port": {
                        "description": "The server's port. Left off, 5432.",
                        "type": "integer"
                      },
                      "tls": {
                        "additionalProperties": false,
                        "description": "How the connection is encrypted. Left off, it is not.",
                        "properties": {
                          "ca": {
                            "additionalProperties": false,
                            "description": "The certificate authority the server's certificate chains to, as PEM, when it is not one the system trusts.",
                            "properties": {
                              "$env": {
                                "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                "pattern": "^[A-Z_][A-Z0-9_]*$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "$env"
                            ],
                            "title": "VariableRef",
                            "type": "object"
                          },
                          "mode": {
                            "description": "require encrypts the connection; verify-full also checks the server's certificate and hostname.",
                            "enum": [
                              "require",
                              "verify-full"
                            ],
                            "type": "string"
                          }
                        },
                        "required": [
                          "mode"
                        ],
                        "title": "PostgresTLS",
                        "type": "object"
                      },
                      "username": {
                        "description": "The role the app connects as.",
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "additionalProperties": false,
                            "properties": {
                              "$env": {
                                "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                "pattern": "^[A-Z_][A-Z0-9_]*$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "$env"
                            ],
                            "title": "VariableRef",
                            "type": "object"
                          }
                        ]
                      }
                    },
                    "required": [
                      "host",
                      "database",
                      "username",
                      "password"
                    ],
                    "title": "PostgresHostBinding",
                    "type": "object"
                  }
                ],
                "title": "PostgresBinding"
              },
              {
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "preview": {
                    "description": "The record previews bind. Left off, previews provision their own.",
                    "oneOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "url": {
                            "additionalProperties": false,
                            "description": "The whole connection string, kept verbatim so its sslmode, options and pooler parameters reach the client.",
                            "properties": {
                              "$env": {
                                "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                "pattern": "^[A-Z_][A-Z0-9_]*$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "$env"
                            ],
                            "title": "VariableRef",
                            "type": "object"
                          }
                        },
                        "required": [
                          "url"
                        ],
                        "title": "PostgresUrlBinding",
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "database": {
                            "description": "The database the app connects to.",
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "$env": {
                                    "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                    "pattern": "^[A-Z_][A-Z0-9_]*$",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "$env"
                                ],
                                "title": "VariableRef",
                                "type": "object"
                              }
                            ]
                          },
                          "host": {
                            "description": "The server's hostname.",
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "$env": {
                                    "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                    "pattern": "^[A-Z_][A-Z0-9_]*$",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "$env"
                                ],
                                "title": "VariableRef",
                                "type": "object"
                              }
                            ]
                          },
                          "password": {
                            "additionalProperties": false,
                            "description": "The role's password.",
                            "properties": {
                              "$env": {
                                "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                "pattern": "^[A-Z_][A-Z0-9_]*$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "$env"
                            ],
                            "title": "VariableRef",
                            "type": "object"
                          },
                          "port": {
                            "description": "The server's port. Left off, 5432.",
                            "type": "integer"
                          },
                          "tls": {
                            "additionalProperties": false,
                            "description": "How the connection is encrypted. Left off, it is not.",
                            "properties": {
                              "ca": {
                                "additionalProperties": false,
                                "description": "The certificate authority the server's certificate chains to, as PEM, when it is not one the system trusts.",
                                "properties": {
                                  "$env": {
                                    "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                    "pattern": "^[A-Z_][A-Z0-9_]*$",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "$env"
                                ],
                                "title": "VariableRef",
                                "type": "object"
                              },
                              "mode": {
                                "description": "require encrypts the connection; verify-full also checks the server's certificate and hostname.",
                                "enum": [
                                  "require",
                                  "verify-full"
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "mode"
                            ],
                            "title": "PostgresTLS",
                            "type": "object"
                          },
                          "username": {
                            "description": "The role the app connects as.",
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "$env": {
                                    "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                    "pattern": "^[A-Z_][A-Z0-9_]*$",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "$env"
                                ],
                                "title": "VariableRef",
                                "type": "object"
                              }
                            ]
                          }
                        },
                        "required": [
                          "host",
                          "database",
                          "username",
                          "password"
                        ],
                        "title": "PostgresHostBinding",
                        "type": "object"
                      }
                    ],
                    "title": "PostgresBinding"
                  },
                  "production": {
                    "description": "The record production binds. Left off, production provisions its own.",
                    "oneOf": [
                      {
                        "additionalProperties": false,
                        "properties": {
                          "url": {
                            "additionalProperties": false,
                            "description": "The whole connection string, kept verbatim so its sslmode, options and pooler parameters reach the client.",
                            "properties": {
                              "$env": {
                                "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                "pattern": "^[A-Z_][A-Z0-9_]*$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "$env"
                            ],
                            "title": "VariableRef",
                            "type": "object"
                          }
                        },
                        "required": [
                          "url"
                        ],
                        "title": "PostgresUrlBinding",
                        "type": "object"
                      },
                      {
                        "additionalProperties": false,
                        "properties": {
                          "database": {
                            "description": "The database the app connects to.",
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "$env": {
                                    "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                    "pattern": "^[A-Z_][A-Z0-9_]*$",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "$env"
                                ],
                                "title": "VariableRef",
                                "type": "object"
                              }
                            ]
                          },
                          "host": {
                            "description": "The server's hostname.",
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "$env": {
                                    "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                    "pattern": "^[A-Z_][A-Z0-9_]*$",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "$env"
                                ],
                                "title": "VariableRef",
                                "type": "object"
                              }
                            ]
                          },
                          "password": {
                            "additionalProperties": false,
                            "description": "The role's password.",
                            "properties": {
                              "$env": {
                                "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                "pattern": "^[A-Z_][A-Z0-9_]*$",
                                "type": "string"
                              }
                            },
                            "required": [
                              "$env"
                            ],
                            "title": "VariableRef",
                            "type": "object"
                          },
                          "port": {
                            "description": "The server's port. Left off, 5432.",
                            "type": "integer"
                          },
                          "tls": {
                            "additionalProperties": false,
                            "description": "How the connection is encrypted. Left off, it is not.",
                            "properties": {
                              "ca": {
                                "additionalProperties": false,
                                "description": "The certificate authority the server's certificate chains to, as PEM, when it is not one the system trusts.",
                                "properties": {
                                  "$env": {
                                    "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                    "pattern": "^[A-Z_][A-Z0-9_]*$",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "$env"
                                ],
                                "title": "VariableRef",
                                "type": "object"
                              },
                              "mode": {
                                "description": "require encrypts the connection; verify-full also checks the server's certificate and hostname.",
                                "enum": [
                                  "require",
                                  "verify-full"
                                ],
                                "type": "string"
                              }
                            },
                            "required": [
                              "mode"
                            ],
                            "title": "PostgresTLS",
                            "type": "object"
                          },
                          "username": {
                            "description": "The role the app connects as.",
                            "oneOf": [
                              {
                                "type": "string"
                              },
                              {
                                "additionalProperties": false,
                                "properties": {
                                  "$env": {
                                    "description": "The ocel variable holding this value, set per class and environment with ocel env set. The app never reads it as a variable of its own.",
                                    "pattern": "^[A-Z_][A-Z0-9_]*$",
                                    "type": "string"
                                  }
                                },
                                "required": [
                                  "$env"
                                ],
                                "title": "VariableRef",
                                "type": "object"
                              }
                            ]
                          }
                        },
                        "required": [
                          "host",
                          "database",
                          "username",
                          "password"
                        ],
                        "title": "PostgresHostBinding",
                        "type": "object"
                      }
                    ],
                    "title": "PostgresBinding"
                  }
                },
                "type": "object"
              }
            ]
          },
          "description": "Each key is a postgres resource this project declares. Its value is \"@\" followed by the name a record is published under, such as \"@warehouse\"; or the record itself, whose secrets are ocel variables written { \"$env\": \"NAME\" }; or that record keyed by the tier it serves, leaving the other tier to provision its own.",
          "type": "object"
        }
      },
      "type": "object"
    },
    "discovery": {
      "additionalProperties": false,
      "description": "Where the resources an app declares are found.",
      "properties": {
        "paths": {
          "description": "The directories holding infrastructure declarations, relative to the config. Left off, ocel reads the default discovery directory.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "title": "DiscoveryConfig",
      "type": "object"
    },
    "dns": {
      "description": "Where the project's hostname records are written, keyed by the DNS service's identifier and holding its options, or named alone.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {
              "zone": {
                "description": "The zone the records are written into. Omit it and ocel picks the zone that covers the hostname.",
                "type": "string"
              }
            },
            "title": "DnsOptions",
            "type": "object"
          },
          "maxProperties": 1,
          "minProperties": 1,
          "type": "object"
        }
      ],
      "title": "DnsDescriptor"
    },
    "domains": {
      "additionalProperties": false,
      "description": "The hostnames this project is served on.",
      "properties": {
        "preview": {
          "description": "The wildcard hostname previews are served under, such as *.preview.example.com.",
          "type": "string"
        },
        "production": {
          "description": "The hostnames production is served on.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ]
        }
      },
      "title": "ProjectDomainConfig",
      "type": "object"
    },
    "edge": {
      "description": "The edge in front of the origin, keyed by its identifier and holding its options, or named alone. Omit it and the provider fronts the deployment with its own default edge.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "additionalProperties": false,
            "properties": {},
            "title": "EdgeOptions",
            "type": "object"
          },
          "maxProperties": 1,
          "minProperties": 1,
          "type": "object"
        }
      ],
      "title": "EdgeDescriptor"
    },
    "provider": {
      "description": "The provider ocel deploy provisions into, keyed by its identifier and holding its options. A provider that needs no options may be named alone.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "additionalProperties": {
            "type": "object"
          },
          "maxProperties": 1,
          "minProperties": 1,
          "type": "object"
        }
      ],
      "title": "ProviderDescriptor"
    },
    "registry": {
      "additionalProperties": false,
      "description": "Where this project's container images are pushed.",
      "properties": {
        "password": {
          "description": "The environment variable holding the password or token, written as \"${REGISTRY_TOKEN}\" and read where the push authenticates — never the secret itself.",
          "pattern": "^\\$\\{([A-Za-z_][A-Za-z0-9_]*)\\}$",
          "type": "string"
        },
        "server": {
          "description": "The registry host and the namespace images sit under, such as ghcr.io/acme. No scheme, and no credentials.",
          "type": "string"
        },
        "username": {
          "description": "The username the push authenticates as, where the registry wants one.",
          "type": "string"
        }
      },
      "required": [
        "server",
        "password"
      ],
      "title": "RegistryConfig",
      "type": "object"
    },
    "slug": {
      "description": "The project's deployment identity. Every stack and resource ocel creates in your own account is keyed on it, so changing it forks a new project.",
      "type": "string"
    },
    "transforms": {
      "description": "Transform modules applied while provisioning, in order — later modules win where their patches collide. Each is a path to a module whose default export is a defineTransform(...) result, keyed by the provider it patches.",
      "oneOf": [
        {
          "type": "string"
        },
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      ]
    }
  },
  "required": [
    "slug"
  ],
  "title": "Ocel project configuration",
  "type": "object"
}
