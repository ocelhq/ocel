{
  "provider": {
    "ids": ["aws", "gcp", "vps"],
    "shorthand": ["aws"],
    "required": {
      "gcp": [
        {
          "name": "project",
          "doc": "The Google Cloud project to deploy into."
        },
        {
          "name": "region",
          "doc": "The region to deploy into. A project spans them all, so this names the one."
        }
      ],
      "vps": [
        {
          "name": "ssh",
          "doc": "The machine to deploy onto: a Host alias from ssh_config, or the destination spelled out."
        }
      ]
    }
  },
  "edges": {
    "aws": {
      "ids": ["api-gateway", "cloudflare", "cloudfront"],
      "shorthand": ["api-gateway", "cloudflare", "cloudfront"]
    },
    "gcp": {
      "ids": ["alb", "cloudflare"],
      "shorthand": ["alb", "cloudflare"]
    },
    "vps": {
      "ids": ["cloudflare"],
      "shorthand": ["cloudflare"]
    }
  },
  "dns": {
    "aws": {
      "ids": ["cloudflare", "route53"],
      "shorthand": ["cloudflare", "route53"]
    },
    "gcp": {
      "ids": ["cloudflare"],
      "shorthand": ["cloudflare"]
    },
    "vps": {
      "ids": ["cloudflare"],
      "shorthand": ["cloudflare"]
    }
  }
}
