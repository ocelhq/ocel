{
  "$schema": "https://ocel.dev/schema/ocel.schema.json",
  "slug": "ocelhq",
  "provider": {
    "aws": {
      "region": "${OCEL_AWS_REGION}",
      "variablesKey": "${OCEL_AWS_VARIABLES_KEY}",
      "edge": "cloudflare",
      "dns": "cloudflare"
    }
  },
  "apps": [
    { "name": "www", "path": "./www", "domains": { "production": "ocel.dev" } },
    {
      "name": "github",
      "path": "./console/github",
      "domains": { "production": "github.ocel.dev" }
    }
  ]
}
