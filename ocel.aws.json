{
  "$schema": "https://ocel.dev/schema/0.0.1-alpha.0/ocel.schema.json",
  "slug": "ocelhq",
  "edge": { "kind": "cloudflare" },
  "dns": { "kind": "cloudflare" },
  "provider": {
    "name": "aws",
    "options": { "region": "${OCEL_AWS_REGION}", "varsKey": "${OCEL_AWS_VARS_KEY}" }
  },
  "apps": [
    { "name": "www", "path": "./www" },
    {
      "name": "github",
      "path": "./console/github",
      "domains": { "production": "github.ocel.dev" }
    }
  ]
}
