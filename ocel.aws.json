{
  "$schema": "https://ocel.dev/schema/0.0.0/ocel.schema.json",
  "slug": "ocelhq",
  "edge": "cloudflare",
  "dns": "cloudflare",
  "provider": {
    "aws": { "region": "${OCEL_AWS_REGION}", "variablesKey": "${OCEL_AWS_VARIABLES_KEY}" }
  },
  "apps": [
    { "name": "www", "path": "./www", "domains": { "production": "ocel.dev" } },
    {
      "name": "github",
      "path": "./console/github",
      "domains": { "production": "github.ocel.dev" }
    }
  ]
}
